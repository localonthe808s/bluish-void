<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bluishvoid.obslog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/vvvaa/bluish-void/_kalshi/obs_log.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/vvvaa/bluish-void/_kalshi</string>
  <!-- five minutes. launchd fires only while the Mac is awake; a missed window
       is a gap in the record, not a failure, and the timestamps make gaps
       obvious. RunAtLoad so the first row lands immediately. -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/vvvaa/bluish-void/_kalshi/obs_trail/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/vvvaa/bluish-void/_kalshi/obs_trail/agent.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
