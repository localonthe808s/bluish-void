INSTALL (macOS, five-minute agent):
    cp _kalshi/obs_log.plist ~/Library/LaunchAgents/com.bluishvoid.obslog.plist
    launchctl load ~/Library/LaunchAgents/com.bluishvoid.obslog.plist
    launchctl list | grep obslog          # confirm it is running
STOP:
    launchctl unload ~/Library/LaunchAgents/com.bluishvoid.obslog.plist
READ IT:
    python3 _kalshi/obs_lead.py
